# FollowUp Companion – environment template
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored; never commit real keys.

# --- Required ---

# Call-E telephony provider key (providers/calle_client.py)
CALLE_API_KEY=iams_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI key, used by the planner agent and the real extractor
# (agents/planner.py, eval/real_extractor.py)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional (defaults shown; uncomment to override) ---

# Call-E API base URL
# CALLE_BASE_URL=https://api.heycall-e.com

# Call-E request timeout in seconds
# CALLE_TIMEOUT_S=30
